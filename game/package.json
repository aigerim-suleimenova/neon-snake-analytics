{
  "name": "neon-snake-game",
  "version": "1.0.0",
  "description": "Neon Snake: a Phaser 3 browser game with Famobi SDK integration and gameplay analytics.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
